# Plantilla de variables de entorno del backend.
# Copia este archivo a `.env` y rellena los valores reales. NO commitees `.env`.

# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/cafe?schema=public"

# Servidor
PORT=3000
API_ROOT=api
API_VERSION=1.0

# CORS: orígenes permitidos separados por coma
ALLOWED_ORIGINS=http://localhost:4200

# Secreto para firmar/verificar los JWT.
# OBLIGATORIO en producción. Genera uno fuerte, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# URL del frontend (enlaces en correos, etc.)
FRONTEND_URL=http://localhost:4200

# Notificaciones por correo (Gmail)
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=
ENV_FROM_ADDRESS=

# Gmail vía OAuth2 (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
