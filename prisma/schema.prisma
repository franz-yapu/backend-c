generator client {
  provider = "prisma-client-js"
  previewFeatures = ["views"] 
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PRODUCER
  ADMIN
  CLIENT
}

enum AuctionStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED
}

enum CoffeeQuality {
  SPECIALTY
  PREMIUM
  STANDARD
  COMMERCIAL
}



enum CoffeeProcess {
  WASHED     // Lavado
  NATURAL    // Natural
  HONEY      // Honey
  ANAEROBIC  // Anaeróbico
  PULPED     // Despulpado
  OTHER      // Otro
}


model Dms {
  id        String   @id @default(uuid())
  fileName  String   @map("file_name")
  path      String
  mimeType  String   @map("mime_type")
  size      Int
  userId    String?
  module    String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("dms")
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("role")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  firstName   String?  @map("first_name")
  lastName    String?  @map("last_name")
  companyName String?  @map("company_name")
  phone       Int?
  address     String?
  city        String?
  country     String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  roleId      String   @map("role_id")

  // Relaciones
  role               Role          @relation(fields: [roleId], references: [id])
  managedAuctions    Auction[]     @relation("ManagedAuctions")
  sellerAuctions     Auction[]     @relation("SellerAuctions")
  bids               Bid[]
  documents          Dms[]
  boughtTransactions Transaction[] @relation("BuyerTransactions")

  @@map("user")
}

model CoffeeLot {
  // Identificación básica
  id              String         @id @default(uuid())         // Unique coffee lot identifier
  name            String                                    // Coffee lot name (e.g., "CAFE TEODOSIO_ESPERANZA B")
  description     String?                                   // Optional description of the lot
  producerName    String?       @map("producer_name")      // Producer name (e.g., "TEODOSIO JUMPIRI")
  isSpecialty     Boolean       @default(false)            // Indicates if it's specialty coffee

  // Información general del café
  cupScore        Float?         @map("cup_score")         // Cup score (e.g., 84.88)
  variety         String?                                  // Coffee variety (e.g., "Catuai rojo")
  process         String?                           // Processing method (washed, natural, honey, etc.)
  dryingSystem    String?        @map("drying_system")     // Drying system (e.g., "Mesa")
  quantityLbs     Float?         @map("quantity_lbs")      // Quantity in pounds (e.g., 384.43)
  quantity        Float                                    // Quantity in kilograms (e.g., 174.38)
  position        Int?                                     // Position in competition or ranking (e.g., 17)

  // Origen del microlote
  harvestYear     Int?           @map("harvest_year")     // Harvest year (e.g., 2024)
  country         String?                                 // Country of origin (e.g., "Bolivia")
  region          String?                                 // Region/Department (e.g., "La Paz")
  province        String?                                 // Province (e.g., "Caranavi")
  municipality    String?                                 // Municipality (e.g., "Caranavi")
  community       String?                                 // Community (e.g., "Esperanza B")

  // Información técnica
  altitude        Int?                                    // Altitude in meters above sea level (e.g., 1750)
  productionSystem String?        @map("production_system") // Production system (e.g., "Ecológico")
  shadeType       String?         @map("shade_type")      // Type of shade (e.g., "Sikyle")

  // Perfil en taza (flavor profile)
  fragranceAroma  String?         @map("fragrance_aroma") // Fragrance/Aroma description (e.g., "sultana, avellanas y chocolate")
  acidity         String?                                // Acidity description (e.g., "cítrica")
  flavor          String?                                // Flavor description (e.g., "nibs de cacao, caramelo, nuez, miel, sedoso y cremoso")
  body            String?                                // Body description
  aftertaste      String?                                // Aftertaste description

  // Información comercial
  status          String         @default("AVAILABLE")   // Lot status (available, sold, etc.)
  suggestedPrice  Decimal?       @map("suggested_price") @db.Decimal(12, 2) // Suggested price
  isInAuction     Boolean        @default(false)         // Is currently in auction
  moistureContent Float?         @map("moisture_content") // Moisture content percentage

  // Multimedia y documentos
  images          String?                               // References to images (could be JSON array)
  documents       String?                               // References to documents (certifications, etc.)

  // Metadata
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relaciones
  seller        String                                // Seller user ID
  auctionId       String?                               // Associated auction ID (if any)


  auction         Auction?    @relation(fields: [auctionId], references: [id])
  auctionDetails  AuctionCoffeeLot[]
  bids            Bid[]
  transactions    Transaction[]

  @@map("coffee_lots")
}


model AuctionCoffeeLot {
  id            String @id @default(uuid())
  startingPrice Decimal  @map("starting_price") @db.Decimal(12, 2)
  reservePrice  Decimal? @map("reserve_price") @db.Decimal(12, 2)
  currentPrice  Decimal? @default(0) @map("current_price") @db.Decimal(12, 2)
  auctionId     String
  coffeeLotId   String

  auction   Auction   @relation(fields: [auctionId], references: [id])
  coffeeLot CoffeeLot @relation(fields: [coffeeLotId], references: [id], onDelete: Cascade)

  @@unique([auctionId, coffeeLotId])
  @@map("auction_coffee_lots")
}

model Auction {
  id           String        @id @default(uuid())
  title        String
  description  String?
  startDate    DateTime      @map("start_date")
  endDate      DateTime      @map("end_date")
  minIncrement Decimal       @default(0.5) @map("min_increment") @db.Decimal(12, 2)
  status       AuctionStatus @default(DRAFT)
  isActive     Boolean       @default(false)

  originalEndDate   DateTime?   @map("original_end_date")   // Fecha original de fin
  extendedTimes     Int         @default(0) @map("extended_times") // Veces que se ha extendido
  extensionEnabled  Boolean     @default(true) @map("extension_enabled") // Si está activa la extensión
  extensionMinutes  Int         @default(3) @map("extension_minutes") // Minutos a extender
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  adminId  String
  sellerId String?

  admin          User               @relation("ManagedAuctions", fields: [adminId], references: [id])
  seller         User?              @relation("SellerAuctions", fields: [sellerId], references: [id])
  coffeeLots     CoffeeLot[]
  auctionDetails AuctionCoffeeLot[]
  bids           Bid[]
  transactions   Transaction[]

  
  @@index([status, isActive])
  @@map("auctions")
}

model Bid {
  id          String   @id @default(uuid())
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  auctionId   String
  userId      String
  coffeeLotId String

  auction   Auction   @relation(fields: [auctionId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  coffeeLot CoffeeLot @relation(fields: [coffeeLotId], references: [id])

  @@index([auctionId, amount])
  // Índice para la consulta caliente de ganador/precio (filtra por lote, ordena por monto).
  @@index([auctionId, coffeeLotId, amount])
  // Índice para findLastBids: filtra por lote y ordena por fecha descendente.
  @@index([auctionId, coffeeLotId, createdAt])
  @@map("bids")
}

model Transaction {
  id          String    @id @default(uuid())
  amount      Decimal   @db.Decimal(12, 2)
  status      String    @default("PENDING")
  paymentDate DateTime? @map("payment_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  auctionId String
  buyerId   String
  sellerId  String
  coffeeLotId String   

  auction Auction @relation(fields: [auctionId], references: [id])
  buyer   User    @relation("BuyerTransactions", fields: [buyerId], references: [id])
   coffeeLot CoffeeLot @relation(fields: [coffeeLotId], references: [id]) // 👈 Relación directa

  @@map("transactions")
}


view UserLog {
  id        String    
  userId    String   @map("user_id")
  action    String
  module    String
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  metadata  Json?
  createdAt DateTime @map("created_at")

  @@map("user_logs")
}

// ==========================================
// BRANDING MODULE (PRD Section 5.11 / 7.1.1)
// ==========================================

model Branding {
  id                    String   @id @default(uuid())
  primaryColor          String   @default("#CA3636") @map("primary_color")
  secondaryColor        String   @default("#FF9A24") @map("secondary_color")
  successColor          String   @default("#10B981") @map("success_color")
  warningColor          String   @default("#F59E0B") @map("warning_color")
  dangerColor           String   @default("#EF4444") @map("danger_color")
  infoColor             String   @default("#3B82F6") @map("info_color")
  surfaceColor          String   @default("#FFFFFF") @map("surface_color")
  textColor             String   @default("#1F2937") @map("text_color")
  logoUrl               String?  @map("logo_url")
  faviconUrl            String?  @map("favicon_url")
  emailLogoUrl          String?  @map("email_logo_url")
  themeMode             String   @default("light") @map("theme_mode")
  fontFamily            String?  @map("font_family")
  borderRadius          String?  @default("4px") @map("border_radius")
  institutionName       String?  @default("Cáritas Bolivia") @map("institution_name")
  institutionShortName  String?  @default("Cáritas") @map("institution_short_name")
  isActive              Boolean  @default(false) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  history BrandHistory[]

  @@map("branding")
}

model BrandHistory {
  id         String   @id @default(uuid())
  brandingId String   @map("branding_id")
  changedBy  String   @map("changed_by")
  changes    Json
  changedAt  DateTime @default(now()) @map("changed_at")

  branding Branding @relation(fields: [brandingId], references: [id], onDelete: Cascade)

  @@map("brand_history")
}

// Override de textos i18n editables desde el admin. Cada fila reemplaza una
// clave de traducción (ej. "NAV.HOME") para un idioma. El front fusiona estos
// valores sobre los JSON base de assets/i18n; si no hay override, usa el base.
model TranslationOverride {
  id        String   @id @default(uuid())
  locale    String
  key       String
  value     String
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([locale, key])
  @@index([locale])
  @@map("translation_overrides")
}
